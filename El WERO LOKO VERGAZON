local function getClosestTargetSilent()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local primaryPart = myChar.PrimaryPart or FindFirstChild(myChar, "HumanoidRootPart")
    if not primaryPart then return nil end
    
    local vpSize = Camera.ViewportSize
    local centerPos = Vector2New(vpSize.X * 0.5, vpSize.Y * 0.5)
    local localPos = primaryPart.CFrame.Position
    local closestPart = nil
    local minDist = math_huge

    local targetPartType = _G.Silent_TargetPart
    local maxRange = _G.Silent_Range
    local maxFOV = _G.Silent_FOV
    local teamCheck = _G.Silent_TeamCheck
    local myTeam = LocalPlayer.Team

    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local pl = allPlayers[i]
        if pl ~= LocalPlayer and IsRealPlayer(pl) then
            if not (teamCheck and myTeam and pl.Team == myTeam) then
                local plChar = pl.Character
                if plChar then
                    local targetPart = getCachedBodyPart(plChar, targetPartType)
                    if targetPart then
                        local targetPos = targetPart.CFrame.Position
                        local dist = (localPos - targetPos).Magnitude
                        
                        if dist <= maxRange then
                            local sp, onScreen = WorldToViewportPoint(Camera, targetPos)
                            if onScreen then
                                local screenDist = (Vector2New(sp.X, sp.Y) - centerPos).Magnitude
                                if screenDist <= maxFOV and dist < minDist then
                                    minDist = dist
                                    closestPart = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

local function checkWeapon()
    local char = LocalPlayer.Character
    if not char then 
        WeaponEquipped = false
        return 
    end
    WeaponEquipped = FindFirstChildOfClass(char, "Tool") ~= nil
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local method = getnamecallmethod()
    local args = {...}
    local self = args[1]

    if _G.Silent_Enabled and not checkcaller() and self == workspace and method == "Raycast" then
        local origin = args[2]
        local direction = args[3]
        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and CurrentTargetSilent then
            local targetPos = CurrentTargetSilent.CFrame.Position
            cachedRaycastParams.FilterDescendantsInstances = {CurrentTargetSilent.Parent}
            args[3] = (targetPos - origin).Unit * math_max(direction.Magnitude, (targetPos - origin).Magnitude + 500)
            args[4] = cachedRaycastParams
            return oldNamecall(unpack(args))
        end
    end

    return oldNamecall(...)
end))

RunService.RenderStepped:Connect(function()
    if not _G.Silent_Enabled then
        FOVCircleSilent.Visible = false
        TracerSilent.Visible = false
        return
    end

    local vpSize = Camera.ViewportSize
    local center = Vector2New(vpSize.X * 0.5, vpSize.Y * 0.5)

    checkWeapon()
    CurrentTargetSilent = getClosestTargetSilent()

    FOVCircleSilent.Position = center
    FOVCircleSilent.Radius = _G.Silent_FOV
    FOVCircleSilent.Visible = _G.Silent_ShowFOV

    if CurrentTargetSilent then
        local sp, onScreen = WorldToViewportPoint(Camera, CurrentTargetSilent.CFrame.Position)
        if onScreen then
            TracerSilent.From = center
            TracerSilent.To = Vector2New(sp.X, sp.Y)
            TracerSilent.Visible = true
        else
            TracerSilent.Visible = false
        end
    else
        TracerSilent.Visible = false
    end
end)

local lastHitboxTick = 0

RunService.Heartbeat:Connect(function(deltaTime)
    lastHitboxTick = lastHitboxTick + deltaTime
    if lastHitboxTick < 0.1 and not _G.Z_Force_Reset then return end
    lastHitboxTick = 0

    if not _G.Z_Hitbox_Active and not _G.Z_Force_Reset then return end

    local lp = LocalPlayer
    local val_size = _G.Z_Hitbox_Size or 20
    local v_size = Vector3New(val_size, val_size, val_size)

    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local p = allPlayers[i]
        if p ~= lp and p.Character then
            local char = p.Character
            local is_team = _G.Z_Team_Check and lp.Team and p.Team == lp.Team

            if not _G.Z_Hitbox_Active or _G.Z_Force_Reset or is_team then
                local charParts = char:GetChildren()
                for j = 1, #charParts do
                    local part = charParts[j]
                    local originalData = originalHitboxData[part]
                    if originalData then
                        part.Size = originalData.Size
                        part.Transparency = originalData.Transparency
                        part.CanCollide = originalData.CanCollide
                        originalHitboxData[part] = nil
                    end
                end
                if is_team then continue end
            end

            if not _G.Z_Hitbox_Active then continue end

            local mode = _G.Z_Hitbox_Mode
            local targetPart = getCachedBodyPart(char, mode)

            if targetPart and targetPart:IsA("BasePart") then
                if targetPart.Size ~= v_size then
                    if not originalHitboxData[targetPart] then
                        originalHitboxData[targetPart] = {
                            Size = targetPart.Size,
                            Transparency = targetPart.Transparency,
                            CanCollide = targetPart.CanCollide
                        }
                    end

                    targetPart.Size = v_size
                    targetPart.Transparency = 0.6
                    targetPart.Color = Color3.fromRGB(255, 0, 0)
                    targetPart.Material = Enum.Material.Neon
                    targetPart.CanCollide = false
                    targetPart.Massless = true

                    local m = FindFirstChildOfClass(targetPart, "SpecialMesh")
                    if m then m.Scale = Vector3New(1, 1, 1) end
                end
            end
        end
    end
    _G.Z_Force_Reset = false 
end)

task.spawn(function()
    local LP = Players.LocalPlayer

    if CoreGui:FindFirstChild("Z_ESP_LITE") then 
        CoreGui.Z_ESP_LITE:Destroy() 
    end

    local ESPGui = Instance.new("ScreenGui")
    ESPGui.Name = "Z_ESP_LITE"
    ESPGui.IgnoreGuiInset = true 

    pcall(function()
        if gethui then
            ESPGui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(ESPGui)
            ESPGui.Parent = CoreGui
        else
            ESPGui.Parent = CoreGui
        end
    end)

    local ESP_Data = {}

    local function CreateESP(player)
        if ESP_Data[player] then return end
        
        local box = Instance.new("Frame", ESPGui)
        box.BackgroundColor3 = Color3.new(1,1,1)
        box.BackgroundTransparency = 1
        box.Visible = false
        
        local stroke = Instance.new("UIStroke", box)
        stroke.Thickness = _G.Z_ESP_Thickness or 1.0
        stroke.Color = _G.Z_ESP_Color

        local bg = Instance.new("Frame", ESPGui)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0.5
        bg.BorderSizePixel = 0
        bg.Visible = false

        local fill = Instance.new("Frame", bg)
        fill.AnchorPoint = Vector2.new(0, 1)
        fill.Position = UDim2.new(0, 0, 1, 0)
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        fill.BorderSizePixel = 0

        ESP_Data[player] = {Box = box, Bg = bg, Fill = fill, Stroke = stroke}
    end

    local function RemoveESP(player)
        if ESP_Data[player] then
            pcall(function()
                ESP_Data[player].Box:Destroy()
                ESP_Data[player].Bg:Destroy()
            end)
            ESP_Data[player] = nil
        end
    end

    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local p = allPlayers[i]
        if p ~= LP then CreateESP(p) end
    end
    
    Players.PlayerAdded:Connect(function(p) 
        if p ~= LP then CreateESP(p) end 
    end)
    Players.PlayerRemoving:Connect(RemoveESP)

    RunService.RenderStepped:Connect(function()
        if not _G.Z_ESP_Master then
            for _, data in pairs(ESP_Data) do
                if data.Box.Visible then data.Box.Visible = false end
                if data.Bg.Visible then data.Bg.Visible = false end
            end
            return
        end

        for player, data in pairs(ESP_Data) do
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if not char or not hum or not hrp or hum.Health <= 0 or not IsRealPlayer(player) then
                data.Box.Visible = false
                data.Bg.Visible = false
                continue
            end

            if _G.Z_ESP_TeamCheck and player.Team and LP.Team and player.Team == LP.Team then
                data.Box.Visible = false
                data.Bg.Visible = false
                continue
            end

            local topWorld = (hrp.CFrame * CFrame.new(0, 3, 0)).Position
            local botWorld = (hrp.CFrame * CFrame.new(0, -3.5, 0)).Position

            local topPos, onScreen = Camera:WorldToViewportPoint(topWorld)
            local botPos = Camera:WorldToViewportPoint(botWorld)

            if onScreen then
                local rawHeight = math.abs(topPos.Y - botPos.Y)
                local height = math.round(math.max(rawHeight, 6))
                local width = math.round(height / 1.8)
                
                local posX = math.round(topPos.X - (width / 2))
                local posY = math.round(topPos.Y)

                if _G.Z_ESP_Boxes then
                    data.Stroke.Color = _G.Z_ESP_Color 
                    data.Stroke.Thickness = _G.Z_ESP_Thickness or 1.0
                    data.Box.Size = UDim2.new(0, width, 0, height)
                    data.Box.Position = UDim2.new(0, posX, 0, posY)
                    data.Box.Visible = true
                else
                    data.Box.Visible = false
                end

                if _G.Z_ESP_HealthBar then
                    local hbWidth = _G.Z_ESP_HealthBarThickness or 2
                    data.Bg.Size = UDim2.new(0, hbWidth, 0, height) 
                    data.Bg.Position = UDim2.new(0, posX - (hbWidth + 2), 0, posY) 
                    data.Bg.Visible = true

                    local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    data.Fill.Size = UDim2.new(1, 0, hpPercent, 0)
                    data.Fill.BackgroundColor3 = Color3.fromHSV(hpPercent * 0.3, 1, 1)
                else
                    data.Bg.Visible = false
                end
            else
                data.Box.Visible = false
                data.Bg.Visible = false
            end
        end
    end)
end)
