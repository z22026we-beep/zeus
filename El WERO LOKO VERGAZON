    end
end)

-- ==================== HITBOX EXPANDER LOGIC ====================
local lastHitboxTick = 0

RunService.Heartbeat:Connect(function(deltaTime)
    lastHitboxTick = lastHitboxTick + deltaTime
    if lastHitboxTick < 0.1 and not _G.Z_Force_Reset then return end
    lastHitboxTick = 0

    if not _G.Z_Hitbox_Active and not _G.Z_Force_Reset then return end

    local lp = LocalPlayer
    local val_size = _G.Z_Hitbox_Size or 20
    local v_size = Vector3New(val_size, val_size, val_size)

    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local p = allPlayers[i]
        if p ~= lp and p.Character then
            local char = p.Character
            local is_team = _G.Z_Team_Check and lp.Team and p.Team == lp.Team

            if not _G.Z_Hitbox_Active or _G.Z_Force_Reset or is_team then
                local charParts = char:GetChildren()
                for j = 1, #charParts do
                    local part = charParts[j]
                    local originalData = originalHitboxData[part]
                    if originalData then
                        part.Size = originalData.Size
                        part.Transparency = originalData.Transparency
                        part.CanCollide = originalData.CanCollide
                        originalHitboxData[part] = nil
                    end
                end
                if is_team then continue end
            end

            if not _G.Z_Hitbox_Active then continue end

            local mode = _G.Z_Hitbox_Mode
            local targetPart = getCachedBodyPart(char, mode)

            if targetPart and targetPart:IsA("BasePart") then
                if targetPart.Size ~= v_size then
                    if not originalHitboxData[targetPart] then
                        originalHitboxData[targetPart] = {
                            Size = targetPart.Size,
                            Transparency = targetPart.Transparency,
                            CanCollide = targetPart.CanCollide
                        }
                    end

                    targetPart.Size = v_size
                    targetPart.Transparency = 0.6
                    targetPart.Color = Color3.fromRGB(255, 0, 0)
                    targetPart.Material = Enum.Material.Neon
                    targetPart.CanCollide = false
                    targetPart.Massless = true

                    local m = FindFirstChildOfClass(targetPart, "SpecialMesh")
                    if m then m.Scale = Vector3New(1, 1, 1) end
                end
            end
        end
    end
    _G.Z_Force_Reset = false 
end)

