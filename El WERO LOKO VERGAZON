FOVCircleSilent.Visible = false

local function getClosestTargetSilent()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local primaryPart = myChar.PrimaryPart or FindFirstChild(myChar, "HumanoidRootPart")
    if not primaryPart then return nil end
    
    local vpSize = Camera.ViewportSize
    local centerPos = Vector2New(vpSize.X * 0.5, vpSize.Y * 0.5)
    local localPos = primaryPart.CFrame.Position
    local closestPart = nil
    local minDist = math_huge

    local targetPartType = _G.Silent_TargetPart
    local maxRange = _G.Silent_Range
    local maxFOV = _G.Silent_FOV
    local teamCheck = _G.Silent_TeamCheck
    local myTeam = LocalPlayer.Team

    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local pl = allPlayers[i]
        if pl ~= LocalPlayer and IsRealPlayer(pl) then
            if not (teamCheck and myTeam and pl.Team == myTeam) then
                local plChar = pl.Character
                if plChar then
                    local targetPart = getCachedBodyPart(plChar, targetPartType)
                    if targetPart then
                        local targetPos = targetPart.CFrame.Position
                        local dist = (localPos - targetPos).Magnitude
                        
                        if dist <= maxRange then
                            local sp, onScreen = WorldToViewportPoint(Camera, targetPos)
                            if onScreen then
                                local screenDist = (Vector2New(sp.X, sp.Y) - centerPos).Magnitude
                                if screenDist <= maxFOV and dist < minDist then
                                    minDist = dist
                                    closestPart = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

local function checkWeapon()
    local char = LocalPlayer.Character
    if not char then 
        WeaponEquipped = false
        return 
    end
    WeaponEquipped = FindFirstChildOfClass(char, "Tool") ~= nil
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local method = getnamecallmethod()
    local args = {...}
    local self = args[1]

    if _G.Silent_Enabled and not checkcaller() and self == workspace and method == "Raycast" then
        local origin = args[2]
        local direction = args[3]
        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and CurrentTargetSilent then
            local targetPos = CurrentTargetSilent.CFrame.Position
            cachedRaycastParams.FilterDescendantsInstances = {CurrentTargetSilent.Parent}
            args[3] = (targetPos - origin).Unit * math_max(direction.Magnitude, (targetPos - origin).Magnitude + 500)
            args[4] = cachedRaycastParams
            return oldNamecall(unpack(args))
        end
    end

    return oldNamecall(...)
end))

