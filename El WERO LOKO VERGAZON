local function IsRealPlayer(player)
    if not player or not player:IsA("Player") or player == LocalPlayer or player.UserId <= 0 then return false end
    
    local char = player.Character
    if not char or not char.Parent then return false end
    
    if botCheckCache[char] ~= nil then
        return botCheckCache[char]
    end

    local hum = FindFirstChildOfClass(char, "Humanoid")
    local head = char:FindFirstChild("Head", true) or FindFirstChild(char, "Head")
    local root = char:FindFirstChild("HumanoidRootPart", true) or FindFirstChild(char, "HumanoidRootPart")
    
    if not hum or hum.Health <= 0 or not head or not root then 
        botCheckCache[char] = false
        return false 
    end

    local isReal = false
    local parts = char:GetChildren()
    for i = 1, #parts do
        local part = parts[i]
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if part.Transparency + part.LocalTransparencyModifier < 0.9 then
                isReal = true
                break
            end
        end
    end
    
    botCheckCache[char] = isReal
    return isReal
end

_G.IsRealPlayer = IsRealPlayer

_G.GetRealPlayers = function()
    local realPlayers = {}
    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local player = allPlayers[i]
        if IsRealPlayer(player) then
            table.insert(realPlayers, player)
        end
    end
    return realPlayers
end

local function getCachedBodyPart(char, targetType)
    if not char then return nil end
    
    local charCache = partCache[char]
    if not charCache then
        charCache = {}
        partCache[char] = charCache
    end
    
    local cachedPart = charCache[targetType]
    if cachedPart and cachedPart.Parent then
        return cachedPart
    end

    local foundPart = nil
    if targetType == "Head" then
        foundPart = char:FindFirstChild("Head", true) or FindFirstChild(char, "Head")
    elseif targetType == "Torso" then
        foundPart = char:FindFirstChild("UpperTorso", true) 
            or char:FindFirstChild("Torso", true) 
            or char:FindFirstChild("LowerTorso", true) 
            or char:FindFirstChild("HumanoidRootPart", true)
    elseif targetType == "Pies" then
        foundPart = char:FindFirstChild("LeftFoot", true) 
            or char:FindFirstChild("RightFoot", true) 
            or char:FindFirstChild("Left Leg", true) 
            or char:FindFirstChild("Right Leg", true)
            or char:FindFirstChild("LowerTorso", true)
    end

    charCache[targetType] = foundPart
    return foundPart
end

