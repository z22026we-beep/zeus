        else
            ESPGui.Parent = CoreGui
        end
    end)

    local ESP_Data = {}

    local function CreateESP(player)
        if ESP_Data[player] then return end
        
        local box = Instance.new("Frame", ESPGui)
        box.BackgroundColor3 = Color3.new(1,1,1)
        box.BackgroundTransparency = 1
        box.Visible = false
        
        local stroke = Instance.new("UIStroke", box)
        stroke.Thickness = _G.Z_ESP_Thickness or 1.0
        stroke.Color = _G.Z_ESP_Color

        local bg = Instance.new("Frame", ESPGui)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0.5
        bg.BorderSizePixel = 0
        bg.Visible = false

        local fill = Instance.new("Frame", bg)
        fill.AnchorPoint = Vector2.new(0, 1)
        fill.Position = UDim2.new(0, 0, 1, 0)
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        fill.BorderSizePixel = 0

        ESP_Data[player] = {Box = box, Bg = bg, Fill = fill, Stroke = stroke}
    end

    local function RemoveESP(player)
        if ESP_Data[player] then
            pcall(function()
                ESP_Data[player].Box:Destroy()
                ESP_Data[player].Bg:Destroy()
            end)
            ESP_Data[player] = nil
        end
    end

    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local p = allPlayers[i]
        if p ~= LP then CreateESP(p) end
    end
    
    Players.PlayerAdded:Connect(function(p) 
        if p ~= LP then CreateESP(p) end 
    end)
    Players.PlayerRemoving:Connect(RemoveESP)

    RunService.RenderStepped:Connect(function()
        if not _G.Z_ESP_Master then
            for _, data in pairs(ESP_Data) do
                if data.Box.Visible then data.Box.Visible = false end
                if data.Bg.Visible then data.Bg.Visible = false end
            end
            return
        end

        for player, data in pairs(ESP_Data) do
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if not char or not hum or not hrp or hum.Health <= 0 or not IsRealPlayer(player) then
                data.Box.Visible = false
                data.Bg.Visible = false
                continue
            end

            if _G.Z_ESP_TeamCheck and player.Team and LP.Team and player.Team == LP.Team then
                data.Box.Visible = false
                data.Bg.Visible = false
                continue
            end

            local topWorld = (hrp.CFrame * CFrame.new(0, 3, 0)).Position
            local botWorld = (hrp.CFrame * CFrame.new(0, -3.5, 0)).Position

            local topPos, onScreen = Camera:WorldToViewportPoint(topWorld)
            local botPos = Camera:WorldToViewportPoint(botWorld)

            if onScreen then
                local rawHeight = math.abs(topPos.Y - botPos.Y)
                local height = math.round(math.max(rawHeight, 6))
                local width = math.round(height / 1.8)
                
                local posX = math.round(topPos.X - (width / 2))
                local posY = math.round(topPos.Y)

                if _G.Z_ESP_Boxes then
                    data.Stroke.Color = _G.Z_ESP_Color 
                    data.Stroke.Thickness = _G.Z_ESP_Thickness or 1.0
                    data.Box.Size = UDim2.new(0, width, 0, height)
                    data.Box.Position = UDim2.new(0, posX, 0, posY)
                    data.Box.Visible = true
                else
                    data.Box.Visible = false
                end

                if _G.Z_ESP_HealthBar then
                    local hbWidth = _G.Z_ESP_HealthBarThickness or 2
                    data.Bg.Size = UDim2.new(0, hbWidth, 0, height) 
                    data.Bg.Position = UDim2.new(0, posX - (hbWidth + 2), 0, posY) 
                    data.Bg.Visible = true

                    local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    data.Fill.Size = UDim2.new(1, 0, hpPercent, 0)
                    data.Fill.BackgroundColor3 = Color3.fromHSV(hpPercent * 0.3, 1, 1)
                else
                    data.Bg.Visible = false
                end
            else
                data.Box.Visible = false
                data.Bg.Visible = false
            end
        end
    end)
end)

